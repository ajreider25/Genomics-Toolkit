from pathlib import Path

INPUT_FASTA = config.get(
    "input",
    "data/sample.fasta"
)

OUTPUT_CSV = config.get(
    "output",
    "results/fasta_stats.csv"
)

rule all:
    input:
        OUTPUT_CSV

rule fasta_statistics:
    input:
        INPUT_FASTA
    output:
        OUTPUT_CSV
    run:
        from genomics_toolkit.operations.fasta.fasta_stats import (
            write_fasta_stats
        )

        write_fasta_stats(
            input_path=input[0],
            output_path=output[0]
        )